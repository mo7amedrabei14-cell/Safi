# SafiData Desktop 1.0 — Server Environment Template (Production / Staging)
# Copy to .env on the server host and replace every placeholder manually.
# NEVER commit real secrets, private keys, or personal emails into Git.

# 1. Runtime & Networking
SAFI_ENV=production
SAFI_BIND_ADDR=0.0.0.0:8080
SAFI_API_BASE_URL=https://api.safidata.app
SAFI_APP_PUBLIC_URL=https://safidata.app
SAFI_CORS_ORIGINS=https://safidata.app,tauri://localhost,https://tauri.localhost

# 2. Primary Database & Cache (Required in production — server fails closed if missing)
DATABASE_URL=postgres://safi_app:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:6432/safidata?sslmode=require
SAFI_VALKEY_URL=redis://:CHANGE_ME_VALKEY_PASSWORD@127.0.0.1:6379/0

# 3. Cryptography & Signing Keys (Generate with cryptographically secure RNG — NEVER reuse across environments)
# 64 hex chars (32 bytes) used for ChaCha20-Poly1305 encryption of Owner TOTP secrets at rest
SAFI_TOTP_ENCRYPTION_KEY=CHANGE_ME_64_HEX_BYTES_TOTP_KEY
SAFI_TOTP_KEY_VERSION=1
# 64 hex chars (32 bytes) Ed25519 private seed for offline Desktop license signing (server-only)
SAFI_LICENSE_SIGNING_PRIVATE_KEY=CHANGE_ME_64_HEX_BYTES_ED25519_LICENSE_SEED
# 64 hex chars (32 bytes) Ed25519 private seed for Desktop update manifest signing (server-only)
SAFI_UPDATE_SIGNING_PRIVATE_KEY=CHANGE_ME_64_HEX_BYTES_ED25519_UPDATE_SEED
# 64 hex chars (32 bytes) HMAC key for OAuth state / internal token signing
SAFI_TOKEN_SIGNING_KEY=CHANGE_ME_64_HEX_BYTES_TOKEN_SIGNING_KEY

# 4. One-Time Sealed Platform Owner Bootstrap
# Set ONLY during initial one-time bootstrap (`sf-server --bootstrap-owner`), then REMOVE from environment.
SAFI_OWNER_BOOTSTRAP_EMAIL=
SAFI_OWNER_TOTP_ISSUER=SafiData

# 5. Transactional Email (SMTP)
SAFI_SMTP_HOST=smtp.example.com
SAFI_SMTP_PORT=587
SAFI_SMTP_USERNAME=CHANGE_ME_SMTP_USER
SAFI_SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SAFI_SMTP_FROM=SafiData <no-reply@safidata.app>

# 6. Phone Verification Providers (SMS Primary + WhatsApp Fallback)
SAFI_SMS_PROVIDER=
SAFI_SMS_API_KEY=
SAFI_SMS_SENDER_ID=SafiData
SAFI_WHATSAPP_PROVIDER=
SAFI_WHATSAPP_API_KEY=
SAFI_WHATSAPP_FROM=

# 7. OAuth Identity Providers (Google / Apple / GitHub)
SAFI_OAUTH_GOOGLE_CLIENT_ID=
SAFI_OAUTH_GOOGLE_CLIENT_SECRET=
SAFI_OAUTH_GOOGLE_REDIRECT_URI=https://api.safidata.app/v1/auth/oauth/google/callback
SAFI_OAUTH_APPLE_CLIENT_ID=
SAFI_OAUTH_APPLE_TEAM_ID=
SAFI_OAUTH_APPLE_KEY_ID=
SAFI_OAUTH_APPLE_PRIVATE_KEY_PEM=
SAFI_OAUTH_APPLE_REDIRECT_URI=https://api.safidata.app/v1/auth/oauth/apple/callback
SAFI_OAUTH_GITHUB_CLIENT_ID=
SAFI_OAUTH_GITHUB_CLIENT_SECRET=
SAFI_OAUTH_GITHUB_REDIRECT_URI=https://api.safidata.app/v1/auth/oauth/github/callback

# 8. Billing & Payment Providers (Paddle International + Paymob Egypt)
SAFI_PADDLE_ENV=sandbox
SAFI_PADDLE_API_KEY=
SAFI_PADDLE_WEBHOOK_SECRET=
SAFI_PADDLE_PRICE_INDIVIDUAL_MONTHLY=
SAFI_PADDLE_PRICE_INDIVIDUAL_ANNUAL=
SAFI_PADDLE_PRICE_ORG_SEAT_ANNUAL=
SAFI_PADDLE_PRICE_PAY_PER_FILE=
SAFI_PADDLE_PRICE_CREDIT_PACK_25=

SAFI_PAYMOB_ENV=sandbox
SAFI_PAYMOB_API_KEY=
SAFI_PAYMOB_SECRET_KEY=
SAFI_PAYMOB_PUBLIC_KEY=
SAFI_PAYMOB_HMAC_SECRET=
SAFI_PAYMOB_INTEGRATION_ID_CARD=
SAFI_PAYMOB_INTEGRATION_ID_WALLET=

# 9. External AI Provider (Optional — user consent + local PII masking enforced)
SAFI_AI_PROVIDER_URL=
SAFI_AI_API_KEY=
SAFI_AI_MODEL=

# 10. Observability & Error Tracking (Self-Hosted)
SAFI_OTLP_ENDPOINT=
SAFI_GLITCHTIP_DSN=
SAFI_LOG_FORMAT=json
