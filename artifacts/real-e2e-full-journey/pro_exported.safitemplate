{
  "format": "safitemplate",
  "schema_version": 1,
  "compatible_app_version": "1.0.0",
  "name": "Cairo Clean Pipeline",
  "description": "Declarative Arabic cleaning workflow",
  "category": "cleaning",
  "recipe_type": "cleaning",
  "required_columns": [
    "full_name",
    "phone",
    "city"
  ],
  "steps": [
    {
      "id": "step_1",
      "op": "normalize_text",
      "columns": [
        "full_name",
        "phone",
        "city"
      ],
      "params": {
        "trim": true
      },
      "reversible": true
    },
    {
      "id": "step_2",
      "op": "dedupe",
      "columns": [],
      "params": {
        "exact": true
      },
      "reversible": true
    },
    {
      "id": "step_ar_3",
      "op": "normalize_text",
      "columns": [
        "all"
      ],
      "params": {
        "normalize_arabic": true,
        "trim": true
      },
      "confidence": 1.0,
      "reversible": true
    }
  ],
